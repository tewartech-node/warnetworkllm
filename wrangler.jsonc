/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "servtechworker",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "servtechdb",
			"database_id": "92b97c4c-dd55-4ae4-ac7e-d0ae2c715044"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "servtechr2"
		}
	],
	// Attaches warnetwork.online directly to this Worker (DNS + SSL are
	// auto-provisioned by Cloudflare). Requires the domain's zone to already
	// exist in this Cloudflare account — add it under Websites in the
	// dashboard first if it isn't there yet, otherwise this entry fails to
	// apply on the next deploy with a "zone not found" error.
	"routes": [
		{ "pattern": "warnetwork.online", "custom_domain": true }
	],
	// Nightly retention sweep: deletes expired uploads, sessions and throttle rows.
	// 14:00 UTC = midnight AEST / 1am AEDT.
	"triggers": {
		"crons": ["0 14 * * *"]
	},
	"vars": {
		"APP_ORIGIN": "https://warnetwork.online"
	},
	// Secrets (not vars — set with `wrangler secret put <NAME>`):
	//   APP_SECRET      required. Keys session-token hashing and IP hashing for
	//                   rate limiting/audit. Generate with:
	//                     openssl rand -base64 32 | wrangler secret put APP_SECRET
	//   NVIDIA_API_KEY  optional. Enables the Deep Think toggle (NVIDIA-hosted
	//                   Nemotron 3 Ultra). Get a free key at https://build.nvidia.com
	//                   and run: wrangler secret put NVIDIA_API_KEY
	//                   If unset, Deep Think falls back to the normal model —
	//                   nothing breaks.
	"upload_source_maps": true
}
